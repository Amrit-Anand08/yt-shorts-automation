# =====================================================
# YouTube Shorts Studio - settings (copy to .env)
# =====================================================

# ---------- PostgreSQL ----------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---------- n8n ----------
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=

# ---------- Channel ----------
CHANNEL_NAME="CODING GALAXY"

# ---------- Google Gemini (script + voice) ----------
GEMINI_API_KEY=

GEMINI_TEXT_PRIMARY=gemini-3.8-flash
GEMINI_TEXT_SECONDARY=gemini-3.1-flash-lite
GEMINI_TEXT_TERTIARY=gemini-3.5-flash-lite
GEMINI_TEXT_FALLBACK_ENABLED=true

GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_PRIMARY=gemini-3.8-flash-tts
GEMINI_TTS_SECONDARY=gemini-3.8-flash-lite-tts
GEMINI_TTS_TERTIARY=gemini-2.5-flash-preview-tts
GEMINI_TTS_FALLBACK_ENABLED=true

# ---------- YouTube upload (V1) ----------
# One-time setup: follow YOUTUBE_SETUP_GUIDE.md
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# private = only you can see it (safe start), unlisted, or public
YT_DEFAULT_PRIVACY=private
# 27 = Education
YT_CATEGORY_ID=27
YT_MADE_FOR_KIDS=false
# Set true only if your videos contain realistic AI-altered content
YT_CONTAINS_SYNTHETIC_MEDIA=false

# ---------- Auto cleanup of local video files (V1) ----------
# Videos/voiceovers older than this many days are deleted (0 = never delete).
# The uploaded YouTube video is NOT affected.
RETENTION_DAYS=3
CLEANUP_INTERVAL_MINUTES=360
# true = only log what would be deleted
CLEANUP_DRY_RUN=false
